# Local development placeholders only. Not production credentials.
# Copy to .env (gitignored) and export before integration tests / Alembic:
#   set -a && . ./.env && set +a

STATEBACK_POSTGRES_HOST=127.0.0.1
STATEBACK_POSTGRES_PORT=5432
STATEBACK_POSTGRES_DB=stateback
STATEBACK_POSTGRES_USER=stateback
STATEBACK_POSTGRES_PASSWORD=stateback_dev_only

# SQLAlchemy 2 + psycopg3 driver name is required for Alembic.
STATEBACK_DATABASE_URL=postgresql+psycopg://stateback:stateback_dev_only@127.0.0.1:5432/stateback

STATEBACK_NATS_URL=nats://127.0.0.1:4222
STATEBACK_NATS_MONITOR_URL=http://127.0.0.1:8222

# Optional, opt-in GitHub sandbox integration. Use a fine-grained token with
# Issues: write only for an isolated non-production repository. Never commit
# a real token. The test also requires both explicit run/confirmation flags.
STATEBACK_RUN_GITHUB_SANDBOX=0
STATEBACK_GITHUB_SANDBOX_CONFIRM_MUTATION=0
STATEBACK_GITHUB_TOKEN=replace_with_ephemeral_sandbox_token
STATEBACK_GITHUB_SANDBOX_OWNER=replace_with_sandbox_owner
STATEBACK_GITHUB_SANDBOX_REPO=replace_with_sandbox_repository
