{
  "revision": "example-production-policy-v1",
  "rules": [
    {
      "rule_id": "github-v01-workflow-requires-approval",
      "verdict": "REQUIRE_APPROVAL",
      "providers": ["github"],
      "actions": [
        "create_issue",
        "create_issue_comment",
        "add_label",
        "create_pull_request",
        "merge_pull_request"
      ],
      "versions": ["v1"],
      "deployment_environments": ["production"],
      "obligations": {
        "require_verification": false,
        "max_automatic_execution_attempts": 1,
        "max_automatic_recovery_attempts": 3,
        "automatic_compensation_allowed": false,
        "operator_reason_required": true,
        "approval_expires_at": null
      }
    }
  ]
}
